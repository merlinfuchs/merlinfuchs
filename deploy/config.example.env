# Copy to /etc/merlinfuchs.env and edit. Every value has a default in the
# scripts, so you only need to set what differs.
#
#   install -m 0640 -o deploy -g deploy config.example.env /etc/merlinfuchs.env

# Where everything lives on the VPS.
SITE_ROOT=/srv/merlinfuchs

# Repository to deploy. Use an https URL for a public repo (no credentials
# needed) or an ssh URL plus a deploy key for a private one.
REPO_URL=https://github.com/merlinfuchs/merlinfuchs.git

# owner/name — only used to ask `gh` which PR is newest.
REPO_SLUG=merlinfuchs/merlinfuchs

# The branch the live site tracks. `desk` for now — the repo's default branch is
# still `master`, which is behind it. Preview shows the newest branch not already
# merged into this one, so changing it changes what both sites mean.
LIVE_BRANCH=desk

# Pin preview to one branch instead of following the newest open PR.
# Leave empty for automatic.
PREVIEW_REF=

# Built releases kept per target, for rollback.
KEEP_RELEASES=5

# Node lives somewhere unusual? Point at it.
# NPM=/usr/local/bin/npm

# Only needed for `gh pr list` on a private repo. A fine-grained token with
# read-only access to this one repository is enough — the VPS never writes.
# GH_TOKEN=
