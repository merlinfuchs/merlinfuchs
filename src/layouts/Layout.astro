---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** Page padding, home is tighter at the sides than the drawer pages. */
  padding?: string;
  /** How far the prop layer bleeds past the content column. */
  propsInset?: string;
}

const {
  title,
  description = "Merlin Fuchs — software, photography, tinkering and sundries.",
  padding = "52px 40px 104px",
  propsInset = "-26px -300px",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="desk" style={`--page-pad:${padding};--props-inset:${propsInset}`}>
      <div class="wrap">
        <slot />
      </div>
    </div>
  </body>
</html>
