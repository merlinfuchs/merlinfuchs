---
/** A loose photo print lying in the page margin. */

interface Props {
  label: string;
  /** Absolute placement inside the prop layer, e.g. "left:184px;top:250px". */
  at: string;
  width: string;
  height: string;
  tilt: string;
  /** White margin around the frame. */
  padding?: string;
}

const { label, at, width, height, tilt, padding = "9px 9px 30px" } = Astro.props;
---

<div class="prop-photo" style={`${at};width:${width};padding:${padding};--tilt:${tilt}`}>
  <div class="prop-photo__img" style={`height:${height}`}>{label}</div>
</div>
