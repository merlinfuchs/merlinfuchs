---
/** Translucent dashed card holding a short list of links. */

interface Props {
  title: string;
  rows: { title: string; href: string; category: string }[];
}

const { title, rows } = Astro.props;
---

<div class="list-card">
  <div class="list-card__title">{title}</div>
  <div class="list-card__rows">
    {
      rows.map((row) => (
        <div class="list-card__row">
          <a href={row.href}>{row.title}</a>
          <span>{row.category}</span>
        </div>
      ))
    }
  </div>
</div>
